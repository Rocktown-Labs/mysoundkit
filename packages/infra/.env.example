CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 S3 upload credentials (Alchemy v2 does not mint these; create them once
# under Cloudflare dashboard R2 > API Tokens and paste the values here and
# into the matching GitHub Actions secrets).
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
RECORDINGS_ACCESS_KEY_ID=
RECORDINGS_SECRET_ACCESS_KEY=

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_GENERATIVE_AI_API_KEY=

# Public app domains are configured in packages/infra/alchemy.run.ts:
# - https://mysoundkit.com
# - https://api.mysoundkit.com
# - https://media.mysoundkit.com
# - PR previews use https://web-pr-<number>.mysoundkit.com and matching API/media hosts

