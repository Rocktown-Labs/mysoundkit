{
  "extends": "@soundkit/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [
      "node",
      "vite/client",
      "@electron-forge/plugin-vite/forge-vite-env"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "forge.config.ts",
    "vite.*.config.ts",
    "forge.env.d.ts"
  ]
}
