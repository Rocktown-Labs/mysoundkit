{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "soundkit-server-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
    },
  },
  "workflows": [
    {
      "name": "soundkit-track-processing",
      "binding": "TRACK_PROCESSING_WORKFLOW",
      "class_name": "TrackProcessingWorkflow",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "02fa325c571741aca9b6acbec0b40546",
    },
  ],
  "placement": {
    "region": "aws:us-east-1",
  },
}
