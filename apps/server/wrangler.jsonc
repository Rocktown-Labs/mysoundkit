{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "soundkit-server-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "containers": [
    {
      "class_name": "MediaProcessorContainer",
      "image": "../media-processor/Dockerfile",
      "max_instances": 20,
      "instance_type": "basic",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DO_METRICS",
      "dataset": "soundkit_do_metrics",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOMS",
        "class_name": "LiveRoomDurableObject",
      },
      {
        "name": "PRESENCE",
        "class_name": "PresenceDurableObject",
      },
      {
        "name": "MEDIA_PROCESSOR",
        "class_name": "MediaProcessorContainer",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["LiveRoomDurableObject", "PresenceDurableObject"],
      "tag": "v1",
    },
    {
      "new_sqlite_classes": ["MediaProcessorContainer"],
      "tag": "v2",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "soundkit-media-dev",
    },
  ],
  "workflows": [
    {
      "name": "soundkit-media-processing",
      "binding": "MEDIA_PROCESSING_WORKFLOW",
      "class_name": "MediaProcessingWorkflow",
    },
    {
      "name": "soundkit-track-enrichment",
      "binding": "TRACK_ENRICHMENT_WORKFLOW",
      "class_name": "TrackEnrichmentWorkflow",
    },
    {
      "name": "soundkit-project-export",
      "binding": "PROJECT_EXPORT_WORKFLOW",
      "class_name": "ProjectExportWorkflow",
    },
    {
      "name": "soundkit-media-retention",
      "binding": "MEDIA_RETENTION_WORKFLOW",
      "class_name": "MediaRetentionWorkflow",
    },
    {
      "name": "soundkit-purchase-fulfillment",
      "binding": "PURCHASE_FULFILLMENT_WORKFLOW",
      "class_name": "PurchaseFulfillmentWorkflow",
    },
    {
      "name": "soundkit-payout-run",
      "binding": "PAYOUT_RUN_WORKFLOW",
      "class_name": "PayoutRunWorkflow",
    },
    {
      "name": "soundkit-live-recording",
      "binding": "LIVE_RECORDING_WORKFLOW",
      "class_name": "LiveRecordingWorkflow",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "LIVE_NOTIFICATION_QUEUE",
        "queue": "soundkit-live-notifications",
      },
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "soundkit-activity-notifications",
      },
    ],
    "consumers": [
      {
        "queue": "soundkit-live-notifications",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 6,
      },
      {
        "queue": "soundkit-activity-notifications",
        "max_batch_size": 25,
        "max_batch_timeout": 3,
        "max_retries": 6,
      },
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1b900b19692a4e9f920eebd379d21d3d",
    },
  ],
  "placement": {
    "region": "aws:us-east-1",
  },
}
