{
  "name": "soundkit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=server",
    "dev:all": "turbo run dev",
    "dev:infra": "turbo run dev --filter=@soundkit/infra",
    "build": "pnpm run check-types && turbo run build",
    "verify": "pnpm run check-types && pnpm run check:react-hooks && pnpm run test && SOUNDKIT_CI_STATIC_CONFIG=true pnpm run build",
    "verify:pr": "pnpm run verify && pnpm run test:e2e",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev --filter=native",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=server",
    "db:push": "turbo run db:push --filter=@soundkit/db",
    "db:studio": "turbo run db:studio --filter=@soundkit/db",
    "db:generate": "turbo run db:generate --filter=@soundkit/db",
    "db:migrate": "turbo run db:migrate --filter=@soundkit/db",
    "db:seed:demo": "turbo run db:seed:demo --filter=@soundkit/db",
    "deploy": "turbo run deploy --filter=@soundkit/infra",
    "deploy:prod": "turbo run deploy --filter=@soundkit/infra",
    "destroy": "turbo run destroy --filter=@soundkit/infra",
    "check": "ultracite check",
    "check:react-hooks": "node scripts/check-react-hook-imports.mjs",
    "fix": "ultracite fix",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:real": "SOUNDKIT_REAL_E2E=true playwright test tests/e2e/real-backend.spec.ts --project=chromium",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "@soundkit/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "^1.60.0",
    "@soundkit/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "ultracite": "7.4.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.9.0"
}
