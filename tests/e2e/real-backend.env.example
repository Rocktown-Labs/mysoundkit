SOUNDKIT_REAL_E2E=true
SOUNDKIT_ISOLATION_MODE=enforce
SOUNDKIT_DATABASE_TARGET=rocktownlabs/soundkit/staging
SOUNDKIT_MEDIA_BUCKET_NAME=soundkit-media-staging
SOUNDKIT_EXTERNAL_EFFECTS_MODE=disabled
PLAYWRIGHT_BASE_URL=https://staging.soundkit.bio
PLAYWRIGHT_API_URL=https://api.staging.soundkit.bio
# Set DATABASE_URL privately to the approved staging runtime connection.
DATABASE_URL=replace-with-staging-runtime-url
SOUNDKIT_E2E_ARTIST_EMAIL=soundkit-fixture-artist@example.test
SOUNDKIT_E2E_ARTIST_PASSWORD=replace-with-staging-fixture-password
SOUNDKIT_E2E_FAN_EMAIL=soundkit-fixture-fan@example.test
SOUNDKIT_E2E_FAN_PASSWORD=replace-with-staging-fixture-password
SOUNDKIT_E2E_SEARCH_STATE=AR
# Commerce is skipped until verified SoundKit sandbox setup (#528).
SOUNDKIT_E2E_EXPECT_CHECKOUT=false
SOUNDKIT_E2E_EXPECT_PREMIUM_CHECKOUT=false
