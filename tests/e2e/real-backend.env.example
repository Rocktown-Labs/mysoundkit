SOUNDKIT_REAL_E2E=true
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4311
PLAYWRIGHT_API_URL=http://127.0.0.1:3000

SOUNDKIT_E2E_ARTIST_EMAIL=artist@example.com
SOUNDKIT_E2E_ARTIST_PASSWORD=replace-me
SOUNDKIT_E2E_FAN_EMAIL=fan@example.com
